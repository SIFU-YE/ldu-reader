# LTP 模型：分片（.partN）随仓库提交（Gitee 不支持 git-lfs 且单文件限 100MB，
# 故 bin 按 90MB 分片入库）；运行时会自动合并为 pytorch_model.bin，
# 合并产物/缓存/临时文件不提交。
LTP/.cache/
LTP/*.tmp
LTP/small/pytorch_model.bin

# Reasonix 工作区元数据（附件/任务状态，不提交）
.reasonix/

# 系统文件
.DS_Store
Thumbs.db

# 本地安装依赖（python -m pip --target .libs）
.libs/
.cache/

